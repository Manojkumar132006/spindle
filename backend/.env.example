# ==============================================================================
# Spindle Backend Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Connection (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://spindle:spindle_password@localhost:5432/spindle

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------

# Google Gemini API Key (Recommended)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL=gemini-2.0-flash

# Optional: Alternative OpenAI / Local LLM Configuration (if not using Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
